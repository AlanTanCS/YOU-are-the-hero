    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Story (Debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\src\\main.py",
            "cwd": "${workspaceFolder}\\tests\\System Test\\Data\\Basic Story3",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        }
    ]
}